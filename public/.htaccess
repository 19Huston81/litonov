# ==============================================================================
# .htaccess для сборки Vite (сайт юриста Литонова)
#
# ВАЖНО: на хостинге должна быть ОТКЛЮЧЕНА опция «перенаправлять все запросы
# на index.html / index.php» (в панели beget/timeweb это отдельная галочка в
# настройках сайта). Именно она возвращает HTML вместо отсутствующего .js-файла
# и вызывает ошибку «блокировано из-за неразрешённого MIME-типа (text/html)».
# ==============================================================================

# Файл по умолчанию в папке
DirectoryIndex index.html

# Корректные MIME-типы для статических ассетов сборки
<IfModule mod_mime.c>
    AddType text/html                  .html
    AddType text/css                   .css
    AddType application/javascript     .js .mjs
    AddType application/json           .json .map
    AddType image/svg+xml              .svg .svgz
    AddType font/woff2                 .woff2
    AddType font/woff                  .woff
</IfModule>

# Разрешаем кэширование шрифтов и ассетов (у них уникальные хэши в именах)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType font/woff2            "access plus 1 year"
    ExpiresByType font/woff             "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/css              "access plus 1 year"
    ExpiresByType text/html             "access plus 1 hour"
</IfModule>

# Сжатие текстовых ассетов
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>